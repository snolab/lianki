*_bak*.ts
solve*.ts

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.vercel
tmp/

.logstest-results/
.logs/
test-results/

# Claude Code local settings (per-machine)
.claude/settings.local.json

# Agent worktrees (git worktree add .wt-<name>)
.wt-*/
# rech/Playwright browser snapshots (may contain sensitive page content)
.playwright-cli-multi-tab/
.shots/

# Python bytecode (scripts/local-stt, scripts/voice)
