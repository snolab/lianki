{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lianki",
  // The OpenNext build (.open-next/worker.js) plus the DebugSessions RPC
  // entrypoint for lianki-push's debug hub — see worker.ts.
  "main": "worker.ts",
  "compatibility_date": "2025-05-05",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // The deployed Worker uses the D1 backend; local `next dev` stays on mongodb
  // via .env.local.
  "vars": {
    "DB_BACKEND": "d1",
    // better-auth's baseURL. Unset, it is inferred per request and every new
    // isolate logs "Base URL could not be determined". `www` 308s to the apex
    // before Next runs, so the apex is the only origin auth ever serves.
    // Locally, .dev.vars overrides this (qa:all writes its own port there).
    "BETTER_AUTH_BASE_URL": "https://lianki.com"
  },
  // Workers Logs: requests and console output kept and searchable in the
  // dashboard (Observability), not only live via `wrangler tail`.
  // Every request's wall/CPU time, status and exceptions go to lianki-monitor
  // (workers/monitor), which keeps metrics and posts alerts to Slack #lianki.
  "tail_consumers": [{ "service": "lianki-monitor" }],
  // lianki-push (workers/push): a new build announces itself through this,
  // and open pages hear it over their WebSocket (lib/announce-build.ts).
  "services": [{ "binding": "PUSH", "service": "lianki-push" }],
  // Source maps are not uploaded: wrangler's bundle of worker.ts plus the
  // OpenNext build produced 61.6 MiB of maps on 2026-11-10, over Cloudflare's
  // 60 MiB limit (error 10021), and every deploy failed. Stack traces in Workers
  // Logs and `wrangler tail` show bundled positions instead. To bring maps
  // back, they must be slimmed under the limit first (docs/shipping.md).
  "upload_source_maps": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // The study ledger's daily anchor (worker.ts `scheduled`, lib/lian/anchor.ts,
  // docs/lian.md): just after UTC midnight it anchors every day that has ended
  // in every time zone. Event-driven by Cloudflare; re-runs change nothing.
  "triggers": { "crons": ["5 0 * * *"] },
  // D1 database (SNOLAB account). Bound as `DB` — see lib/d1/index.ts.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lianki",
      "database_id": "a2c6b8cf-8a94-4cdc-99fd-bbbf6b679f4c",
      "migrations_dir": "db/migrations"
    }
  ],
  // R2 bucket for TTS audio cache and readMaterials content (replaces GridFS).
  // Bound as `BLOBS` — see lib/d1/index.ts.
  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "lianki-blobs"
    }
  ]
}
