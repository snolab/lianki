{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "downlevelIteration": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@lianki/core": ["./packages/core/src/index.ts"],
      // Deep imports, for bundles that must not pull in the whole barrel —
      // see the @lianki/core/watchStats import in src/lianki.user.ts.
      "@lianki/core/*": ["./packages/core/src/*.ts"],
      "@lianki/debug-chat/*": ["./packages/debug-chat/src/*"],
      "@lianki/lian": ["./packages/lian/src/index.ts"],
      "@lianki/lian/*": ["./packages/lian/src/*.ts"],
      "@lianki/ui-state": ["./packages/ui-state/src/index.ts"],
      "@lianki/ui-state/account": ["./packages/ui-state/src/account.ts"],
      "@lianki/ui-state/dirty": ["./packages/ui-state/src/dirty.ts"],
      // rgui, the vendored component library (docs/rgui.md): the app imports
      // only its pure gantt module, never its Canvas/WebGPU entry.
      "@snomiao/rgui/gantt": ["./packages/rgui/src/gantt/index.ts"]
    },
    "target": "ES2017"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.d.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "archived",
    "tmp",
    "src/lianki.user.ts",
    "apps",
    "packages/ext",
    // Vendored upstream (git subtree, docs/rgui.md): it typechecks with its
    // own tsconfig (vite/client, WebGPU and three types). What the app imports
    // from it is still checked here, through the imports.
    "packages/rgui",
    "workers/edge"
  ]
}
