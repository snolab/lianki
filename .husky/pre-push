# Gate before code leaves the machine, cheapest first so a failure surfaces in
# seconds: whole-repo lint, typecheck, the unit suite with its coverage gate
# (bunfig.toml) — all moved here from pre-commit on 2026-11-04 — then qa:all,
# the full integration gate: builds the OpenNext Worker, boots `wrangler dev` on
# local D1, and runs the API + UI + sync + userscript suites against the real
# deployed backend path. See scripts/qa/qa-all.mjs. CI runs lint, typecheck and
# the unit suite on every PR; qa:all runs nightly (docs/shipping.md).
#
# Never `git push --no-verify` (AGENTS.md).
#
# Skip automatically when the push only DELETES remote refs — there is nothing
# to build or test, and qa:all is a multi-minute build. git feeds one line per
# ref on stdin: "<local_ref> <local_sha> <remote_ref> <remote_sha>"; a deletion
# has an all-zero <local_sha>.
saw_ref=0
only_deletes=1
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  saw_ref=1
  case "$local_sha" in
  *[!0]*) only_deletes=0 ;; # any non-zero char ⇒ a real ref update, not a delete
  esac
done
if [ "$saw_ref" = "1" ] && [ "$only_deletes" = "1" ]; then
  echo "pre-push: deletion-only push — nothing to check"
  exit 0
fi

# Cheap gates first, so a lint, type or unit failure fails in seconds, not after
# the multi-minute build. husky already runs hooks with `sh -e`; the explicit
# `set -e` keeps it true if the hook is ever run by hand.
set -e
bun run lint
bun run typecheck

# The heavy part holds one slot of the machine-wide gate (two slots) as one
# stretch: a third agent queues here instead of timing out everyone's tests, and
# the slot is not given up between the unit suite and qa:all. Both take a slot
# themselves when run by hand; inside this they see it is theirs and just run. Lint
# and typecheck stay outside: short, and they fail fast. One attempt, never a
# retry: docs/shipping.md, "Two heavy runs at a time".
#
# Inside: skip qa:all, and only qa:all, on native Windows (Git Bash / MSYS), where
# it cannot pass: the OpenNext Cloudflare packaging breaks there. With bun's
# isolated linker its traced copy turns directory symlinks into file symlinks
# ("Access is denied" in esbuild); with a hoisted install the Worker boots but
# every route fails with ChunkLoadError on Turbopack server chunks. Verified
# 2026-10-14; neither failure involves the code being pushed. The nightly CI run
# of the identical `qa:all` on Linux is the gate there. WSL is not affected
# (uname = Linux). Set LIANKI_QA_ON_WINDOWS=1 to run it anyway (e.g. after an
# OpenNext upgrade).
bun scripts/dev/machine-lock.ts --label "git push: unit suite, qa:all" -- sh -ec '
bun run test:unit -- --coverage

case "$(uname -s 2>/dev/null)" in
MINGW* | MSYS* | CYGWIN*)
  if [ "${LIANKI_QA_ON_WINDOWS:-}" != "1" ]; then
    echo "pre-push: native Windows — qa:all cannot run here (OpenNext packaging); the nightly CI run is the gate."
    echo "pre-push: set LIANKI_QA_ON_WINDOWS=1 to force it."
    exit 0
  fi
  ;;
esac

bun run qa:all
'
