# Full integration gate before code leaves the machine: builds the OpenNext
# Worker, boots `wrangler dev` on local D1, and runs the API + UI + sync +
# userscript suites against the real deployed backend path. See scripts/qa/qa-all.mjs.
#
# Skip in an emergency with `git push --no-verify` ONLY if you understand the
# risk — CI runs the same `qa:all`, so a skip just defers the failure.
#
# Skip automatically when the push only DELETES remote refs — there is nothing
# to build or test, and qa:all is a multi-minute build. git feeds one line per
# ref on stdin: "<local_ref> <local_sha> <remote_ref> <remote_sha>"; a deletion
# has an all-zero <local_sha>.
saw_ref=0
only_deletes=1
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  saw_ref=1
  case "$local_sha" in
  *[!0]*) only_deletes=0 ;; # any non-zero char ⇒ a real ref update, not a delete
  esac
done
if [ "$saw_ref" = "1" ] && [ "$only_deletes" = "1" ]; then
  echo "pre-push: deletion-only push — skipping qa:all"
  exit 0
fi

# Skip on native Windows (Git Bash / MSYS), where the gate cannot pass: the
# OpenNext Cloudflare packaging breaks there — with bun's isolated linker its
# traced copy turns directory symlinks into file symlinks ("Access is denied"
# in esbuild), and with a hoisted install the Worker boots but every route
# fails with ChunkLoadError on Turbopack server chunks. Verified 2026-10-14;
# neither failure involves the code being pushed. CI runs the identical
# `qa:all` on Linux and remains the gate. WSL is not affected (uname = Linux).
# Set LIANKI_QA_ON_WINDOWS=1 to run it anyway (e.g. after an OpenNext upgrade).
case "$(uname -s 2>/dev/null)" in
MINGW* | MSYS* | CYGWIN*)
  if [ "${LIANKI_QA_ON_WINDOWS:-}" != "1" ]; then
    echo "pre-push: native Windows — qa:all cannot run here (OpenNext packaging); CI is the gate."
    echo "pre-push: set LIANKI_QA_ON_WINDOWS=1 to force it."
    exit 0
  fi
  ;;
esac

# Cheap gates first, so a lint or type error fails in a second, not after the
# multi-minute build.
bun run lint
bun run typecheck
bun run qa:all
