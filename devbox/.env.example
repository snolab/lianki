# Copy to devbox/.env (gitignored). One box per friend: a different DEVBOX_NAME
# (and DEVBOX_DEV_PORT) per copy — see devbox/README.md, "Another friend".

# The friend's handle. The box clones branch friend/<DEVBOX_NAME>.
DEVBOX_NAME=kishouzet

# Host loopback port for the box's dev server (127.0.0.1:<port> on the Mac).
DEVBOX_DEV_PORT=3200

# The public URL the host tunnel serves the dev server at, once it exists
# (devbox/host-tunnel.sh). Empty: http://localhost:<DEVBOX_DEV_PORT>.
DEVBOX_PUBLIC_URL=

# Sign in through lianki.com instead of a local account (docs/box-oauth.md): the
# client id the owner gets at /dev/box-clients. Not a secret. Empty: a local
# account on the local D1. Scope must not exceed what the owner granted.
DEVBOX_LIANKI_CLIENT_ID=
DEVBOX_LIANKI_SCOPE=

# Resource limits.
DEVBOX_CPUS=4
DEVBOX_MEMORY=6g

# 1 runs dsh web inside the box (loopback only).
DEVBOX_DSH=1

# Host loopback port forwarded to the box's dsh web (:3080).
DEVBOX_DSH_PORT=3280

# Set ONLY after the Cloudflare Access app for dsh-<name>.lianki.com exists
# (README, "dsh behind Cloudflare Access"). Empty: dsh stays on the box's loopback.
DEVBOX_DSH_PUBLIC_HOST=
DEVBOX_DSH_ACCESS_AUD=
CF_ACCESS_TEAM=

# The file the box reads DEEPSEEK_API_KEY from, relative to devbox/.
DEVBOX_ENV_FILE=.env

# DeepSeek API key for dsh. Owner-provided; set it yourself, never in chat:
#   read -s K && printf 'DEEPSEEK_API_KEY=%s\n' "$K" >> devbox/.env
# DEEPSEEK_API_KEY=
