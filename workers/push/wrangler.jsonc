// lianki-push: tells open pages that a new build is serving — pushed, never
// polled. One Durable Object holds every page's WebSocket with the hibernation
// API (an idle socket costs nothing). A new build announces itself over the
// main Worker's service binding and the object pushes it to all of them.
// Routed in front of the main Worker for /api/version/* only; no workers.dev
// URL, so /internal/publish is reachable through the binding alone.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lianki-push",
  "main": "src/index.ts",
  "workers_dev": false,
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "lianki.com/api/version/*", "zone_name": "lianki.com" }],
  "durable_objects": {
    "bindings": [
      { "name": "HUB", "class_name": "VersionHub" },
      { "name": "DEBUG", "class_name": "DebugHub" },
      { "name": "PROGRESS", "class_name": "ProgressHub" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["VersionHub"] },
    { "tag": "v2", "new_sqlite_classes": ["DebugHub"] },
    { "tag": "v3", "new_sqlite_classes": ["ProgressHub"] },
  ],
  // Asks the main Worker whether a debug socket's cookie is the owner's
  // (/api/dev/whoami). Circular with its PUSH binding to us; that is allowed.
  // SESSIONS: the main Worker's DebugSessions RPC entrypoint (worker.ts), which
  // the debug hub asks before each eval-grant renewal; no URL, no secret.
  "services": [
    { "binding": "MAIN", "service": "lianki" },
    { "binding": "SESSIONS", "service": "lianki", "entrypoint": "DebugSessions" },
  ],
  // Secret PROGRESS_TOKEN (wrangler secret put PROGRESS_TOKEN -c workers/push/wrangler.jsonc):
  // agents' bearer token for live progress. Unset = writes answer 503.
  // Secret PARTNER_TICKET_PUB (wrangler secret put PARTNER_TICKET_PUB -c workers/push/wrangler.jsonc
  // < ~/.config/lianki-stt/ticket.pub): the Learning Partner tickets' public key
  // (docs/dev-debug-widget.md, "On every site"). Unset = sockets from other sites are refused.
  "observability": { "enabled": true },
}
