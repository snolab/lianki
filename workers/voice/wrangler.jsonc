// lianki-voice: the pre-rendered word clips, answered at the edge with no
// session lookup and no Next.js (src/index.ts). Routed in front of the main
// Worker for /api/words/tts only; whatever it has no recording for goes on to
// the main Worker over MAIN. No workers.dev URL.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lianki-voice",
  "main": "src/index.ts",
  "workers_dev": false,
  "compatibility_date": "2026-10-01",
  // `*`: route patterns are matched with the query string, and every clip has one.
  "routes": [{ "pattern": "lianki.com/api/words/tts*", "zone_name": "lianki.com" }],
  // The main Worker's bucket; this Worker only reads voice/.
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "lianki-blobs" }],
  "services": [{ "binding": "MAIN", "service": "lianki" }],
  // Wall/CPU time of every clip to lianki_metrics (index "voice"), as for the main Worker.
  "tail_consumers": [{ "service": "lianki-monitor" }],
  "observability": { "enabled": true },
}
