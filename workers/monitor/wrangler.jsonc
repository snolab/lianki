// lianki-monitor: watches the `lianki` Worker and posts alerts to Slack #lianki.
// Event-driven only — no polling, no cron: it is the tail consumer of `lianki`
// (see the main wrangler.jsonc) and acts on each real request's wall/CPU
// time, status and exceptions as they happen.
// Metrics go to Analytics Engine (dataset lianki_metrics); alerts and their
// de-duplication state live in KV. Slack: secret SLACK_WEBHOOK_URL (an
// incoming webhook for #lianki), or SLACK_BOT_TOKEN + SLACK_CHANNEL.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lianki-monitor",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // No schedule: an empty list also removes any cron left from earlier deploys.
  "triggers": { "crons": [] },
  "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "lianki_metrics" }],
  "kv_namespaces": [{ "binding": "STATE", "id": "42b76cf56ac84b10b4375a458a98ad88" }],
  "vars": {
    "SLACK_CHANNEL": "C0AGG02J0GY",
  },
  "observability": { "enabled": true },
}
