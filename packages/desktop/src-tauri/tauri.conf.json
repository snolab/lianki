{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lianki",
  "version": "0.1.0",
  "identifier": "com.lianki.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "snolab",
    "shortDescription": "Spaced repetition with FSRS",
    "longDescription": "Lianki desktop shell: a native window around https://lianki.com.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
